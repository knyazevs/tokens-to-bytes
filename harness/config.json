{
  "version": "1.0.0",
  "name": "llm-asm-evolution-benchmark",
  "description": "Autonomous closed-loop optimization benchmark measuring LLM low-level code synthesis, token cost, error rates, and iterations to hardware parity.",
  "tasks": {
    "duel3-stack-vm": {
      "id": "duel3-stack-vm",
      "name": "Native x86-64 Stack VM Bytecode Interpreter",
      "prompt": "harness/prompts/duel3-stack-vm.md",
      "output_file": "harness/sandbox/candidate_vm.S",
      "binary_file": "harness/sandbox/vm_bench.exe",
      "build_command": "D:\\projects\\wasm\\.tools\\node_modules\\@lasm\\emscripten-win32-x64\\tools\\emscripten-6.0.9-win32-x64-tools\\bin\\clang.exe -O3 -march=native -mavx2 harness/eval_vm.cpp native/vm_cpp.cpp native/vm_macro.S harness/sandbox/candidate_vm.S -o harness/sandbox/vm_bench.exe",
      "eval_command": "harness\\sandbox\\vm_bench.exe",
      "target": {
        "verified": true,
        "max_cycles_per_op": 1.80,
        "min_speedup_percent": 50.0
      },
      "reference": {
        "author": "Macro-ASM Direct Threading Baseline",
        "cpp_cycles": 3.66,
        "candidate_cycles": 1.65,
        "speedup_percent": 54.4
      }
    },
    "http-engine-linux": {
      "id": "http-engine-linux",
      "name": "Bare-Metal Linux x86-64 HTTP Engine",
      "prompt": "harness/prompts/http-engine-linux.md",
      "output_file": "harness/sandbox/server.S",
      "binary_file": "harness/sandbox/server",
      "wsl_binary": "/mnt/d/projects/wasm/harness/sandbox/server",
      "build_command": "wsl gcc -nostdlib -static -O3 -march=native /mnt/d/projects/wasm/harness/sandbox/server.S -o /mnt/d/projects/wasm/harness/sandbox/server && wsl strip --strip-all /mnt/d/projects/wasm/harness/sandbox/server",
      "port": 8098,
      "test_command": "node builds/test-http.mjs 8098",
      "bench_command": "node builds/bench-multi.mjs 8098 20000 40",
      "target": {
        "tests_passed": 8,
        "max_binary_size_bytes": 10000,
        "min_rps": 130000,
        "max_p99_latency_us": 2000
      },
      "reference": {
        "author": "Human/Macro-ASM Baseline",
        "tests_passed": 8,
        "binary_size_bytes": 2632,
        "rps": 139581,
        "p99_latency_us": 1502
      }
    }
  }
}
