;; JSON-парсер, написанный вручную как WAT и собранный wasm-as.
;;
;; Память: 0x10000 — входной буфер (64 КиБ), 0x20000 — буфер корневой строки
;; (4 КиБ). Модуль ничего не импортирует; счётчики и корневое значение
;; доступны через экспорты json_*.

(module
  (memory (export "memory") 4)

  (global $pos (mut i32) (i32.const 0))
  (global $len (mut i32) (i32.const 0))
  (global $err_code (mut i32) (i32.const 0))
  (global $err_pos (mut i32) (i32.const 0))
  (global $root_type (mut i32) (i32.const 0))
  (global $root_len (mut i32) (i32.const 0))
  (global $root_number (mut f64) (f64.const 0))
  (global $nodes (mut i32) (i32.const 0))
  (global $depth_max (mut i32) (i32.const 0))
  (global $numbers (mut i32) (i32.const 0))
  (global $strings (mut i32) (i32.const 0))
  (global $string_bytes (mut i32) (i32.const 0))

  (func $byte_at (param $i i32) (result i32)
    (i32.load8_u offset=65536 (local.get $i)))

  (func $fail (param $code i32) (param $at i32) (result i32)
    (global.set $err_code (local.get $code))
    (global.set $err_pos (local.get $at))
    (i32.const 0))

  (func $skip_ws
    (local $c i32)
    (local $p i32)
    (local $len i32)
    (local.set $p (global.get $pos))
    (local.set $len (global.get $len))
    (block $done
      (loop $again
        (br_if $done (i32.ge_s (local.get $p) (local.get $len)))
        (local.set $c (i32.load8_u offset=65536 (local.get $p)))
        (br_if $done (i32.gt_u (local.get $c) (i32.const 32)))
        (br_if $done
          (i32.eqz
            (i32.or
              (i32.or (i32.eq (local.get $c) (i32.const 32)) (i32.eq (local.get $c) (i32.const 9)))
              (i32.or (i32.eq (local.get $c) (i32.const 10)) (i32.eq (local.get $c) (i32.const 13))))))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))
        (br $again)))
    (global.set $pos (local.get $p)))

  (func $pow10i (param $e i32) (result f64)
    (local $r f64)
    (local $n i32)
    (local.set $r (f64.const 1))
    (local.set $n (local.get $e))
    (block $done
      (loop $again
        (br_if $done (i32.le_s (local.get $n) (i32.const 0)))
        (local.set $r (f64.mul (local.get $r) (f64.const 10)))
        (local.set $n (i32.sub (local.get $n) (i32.const 1)))
        (br $again)))
    (local.get $r))

  (func $store_byte (param $keep i32) (param $outlen i32) (param $b i32) (result i32)
    (if (local.get $keep)
      (then
        (if (i32.ge_s (local.get $outlen) (i32.const 4096))
          (then (return (i32.const 0))))
        (i32.store8 offset=131072 (local.get $outlen) (local.get $b))))
    (i32.const 1))

  (func $emit_cp (param $keep i32) (param $outlen i32) (param $cp i32) (result i32)
    (if (i32.lt_s (local.get $cp) (i32.const 0x80))
      (then
        (if (i32.eqz (call $store_byte (local.get $keep) (local.get $outlen) (local.get $cp)))
          (then (return (i32.const -1))))
        (return (i32.add (local.get $outlen) (i32.const 1)))))
    (if (i32.lt_s (local.get $cp) (i32.const 0x800))
      (then
        (if (i32.eqz (call $store_byte (local.get $keep) (local.get $outlen)
              (i32.or (i32.const 0xC0) (i32.shr_s (local.get $cp) (i32.const 6)))))
          (then (return (i32.const -1))))
        (if (i32.eqz (call $store_byte (local.get $keep) (i32.add (local.get $outlen) (i32.const 1))
              (i32.or (i32.const 0x80) (i32.and (local.get $cp) (i32.const 0x3F)))))
          (then (return (i32.const -1))))
        (return (i32.add (local.get $outlen) (i32.const 2)))))
    (if (i32.lt_s (local.get $cp) (i32.const 0x10000))
      (then
        (if (i32.eqz (call $store_byte (local.get $keep) (local.get $outlen)
              (i32.or (i32.const 0xE0) (i32.shr_s (local.get $cp) (i32.const 12)))))
          (then (return (i32.const -1))))
        (if (i32.eqz (call $store_byte (local.get $keep) (i32.add (local.get $outlen) (i32.const 1))
              (i32.or (i32.const 0x80) (i32.and (i32.shr_s (local.get $cp) (i32.const 6)) (i32.const 0x3F)))))
          (then (return (i32.const -1))))
        (if (i32.eqz (call $store_byte (local.get $keep) (i32.add (local.get $outlen) (i32.const 2))
              (i32.or (i32.const 0x80) (i32.and (local.get $cp) (i32.const 0x3F)))))
          (then (return (i32.const -1))))
        (return (i32.add (local.get $outlen) (i32.const 3)))))
    (if (i32.eqz (call $store_byte (local.get $keep) (local.get $outlen)
          (i32.or (i32.const 0xF0) (i32.shr_s (local.get $cp) (i32.const 18)))))
      (then (return (i32.const -1))))
    (if (i32.eqz (call $store_byte (local.get $keep) (i32.add (local.get $outlen) (i32.const 1))
          (i32.or (i32.const 0x80) (i32.and (i32.shr_s (local.get $cp) (i32.const 12)) (i32.const 0x3F)))))
      (then (return (i32.const -1))))
    (if (i32.eqz (call $store_byte (local.get $keep) (i32.add (local.get $outlen) (i32.const 2))
          (i32.or (i32.const 0x80) (i32.and (i32.shr_s (local.get $cp) (i32.const 6)) (i32.const 0x3F)))))
      (then (return (i32.const -1))))
    (if (i32.eqz (call $store_byte (local.get $keep) (i32.add (local.get $outlen) (i32.const 3))
          (i32.or (i32.const 0x80) (i32.and (local.get $cp) (i32.const 0x3F)))))
      (then (return (i32.const -1))))
    (i32.add (local.get $outlen) (i32.const 4)))

  (func $hex4 (param $at i32) (result i32)
    (local $v i32)
    (local $i i32)
    (local $c i32)
    (local $d i32)
    (local.set $v (i32.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $again
        (br_if $done (i32.ge_s (local.get $i) (i32.const 4)))
        (if (i32.ge_s (global.get $pos) (global.get $len))
          (then
            (drop (call $fail (i32.const 6) (local.get $at)))
            (return (i32.const -1))))
        (local.set $c (i32.load8_u offset=65536 (global.get $pos)))
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (if (i32.and (i32.ge_s (local.get $c) (i32.const 48)) (i32.le_s (local.get $c) (i32.const 57)))
          (then (local.set $d (i32.sub (local.get $c) (i32.const 48))))
          (else
            (if (i32.and (i32.ge_s (local.get $c) (i32.const 97)) (i32.le_s (local.get $c) (i32.const 102)))
              (then (local.set $d (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 10))))
              (else
                (if (i32.and (i32.ge_s (local.get $c) (i32.const 65)) (i32.le_s (local.get $c) (i32.const 70)))
                  (then (local.set $d (i32.add (i32.sub (local.get $c) (i32.const 65)) (i32.const 10))))
                  (else
                    (drop (call $fail (i32.const 6) (local.get $at)))
                    (return (i32.const -1))))))))
        (local.set $v (i32.or (i32.shl (local.get $v) (i32.const 4)) (local.get $d)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $again)))
    (local.get $v))

  (func $parse_string (param $is_key i32) (param $depth i32) (result i32)
    (local $start i32)
    (local $outlen i32)
    (local $keep i32)
    (local $c i32)
    (local $esc i32)
    (local $e i32)
    (local $cp i32)
    (local $hi i32)
    (local $lo i32)
    (local $next i32)
    (local $known i32)
    (local $bad i32)
    (local.set $start (global.get $pos))
    (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
    (local.set $outlen (i32.const 0))
    (local.set $keep
      (i32.and (i32.eqz (local.get $is_key)) (i32.eq (local.get $depth) (i32.const 1))))
    (block $done
      (loop $again
        (if (i32.ge_s (global.get $pos) (global.get $len))
          (then (return (call $fail (i32.const 2) (global.get $len)))))
        (local.set $c (i32.load8_u offset=65536 (global.get $pos)))
        (if (i32.eq (local.get $c) (i32.const 34))
          (then
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
            (if (local.get $keep) (then (global.set $root_len (local.get $outlen))))
            (global.set $strings (i32.add (global.get $strings) (i32.const 1)))
            (global.set $string_bytes (i32.add (global.get $string_bytes) (local.get $outlen)))
            (return (i32.const 1))))
        (if (i32.lt_s (local.get $c) (i32.const 32))
          (then (return (call $fail (i32.const 6) (global.get $pos)))))
        (if (i32.ne (local.get $c) (i32.const 92))
          (then
            (if (local.get $keep)
              (then
                (if (i32.ge_s (local.get $outlen) (i32.const 4096))
                  (then (return (call $fail (i32.const 8) (local.get $start)))))
                (i32.store8 offset=131072 (local.get $outlen) (local.get $c))))
            (local.set $outlen (i32.add (local.get $outlen) (i32.const 1)))
            (global.set $pos (i32.add (global.get $pos) (i32.const 1))))
          (else
            (local.set $esc (global.get $pos))
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
            (if (i32.ge_s (global.get $pos) (global.get $len))
              (then (return (call $fail (i32.const 2) (global.get $len)))))
            (local.set $e (i32.load8_u offset=65536 (global.get $pos)))
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
            (local.set $cp (i32.const 0))
            (local.set $known (i32.const 0))
            (local.set $bad (i32.const 0))
            (if (i32.or (i32.or (i32.eq (local.get $e) (i32.const 34))
                                (i32.eq (local.get $e) (i32.const 92)))
                        (i32.eq (local.get $e) (i32.const 47)))
              (then
                (local.set $cp (local.get $e))
                (local.set $known (i32.const 1))))
            (if (i32.eq (local.get $e) (i32.const 98))
              (then (local.set $cp (i32.const 8)) (local.set $known (i32.const 1))))
            (if (i32.eq (local.get $e) (i32.const 102))
              (then (local.set $cp (i32.const 12)) (local.set $known (i32.const 1))))
            (if (i32.eq (local.get $e) (i32.const 110))
              (then (local.set $cp (i32.const 10)) (local.set $known (i32.const 1))))
            (if (i32.eq (local.get $e) (i32.const 114))
              (then (local.set $cp (i32.const 13)) (local.set $known (i32.const 1))))
            (if (i32.eq (local.get $e) (i32.const 116))
              (then (local.set $cp (i32.const 9)) (local.set $known (i32.const 1))))
            (if (i32.eq (local.get $e) (i32.const 117))
              (then
                (local.set $known (i32.const 1))
                (local.set $hi (call $hex4 (local.get $esc)))
                (if (i32.lt_s (local.get $hi) (i32.const 0))
                  (then (return (i32.const 0))))
                (if (i32.and (i32.ge_s (local.get $hi) (i32.const 0xD800))
                             (i32.le_s (local.get $hi) (i32.const 0xDBFF)))
                  (then
                    (if (i32.or (i32.or (i32.ge_s (i32.add (global.get $pos) (i32.const 1)) (global.get $len))
                                        (i32.ne (i32.load8_u offset=65536 (global.get $pos)) (i32.const 92)))
                                (i32.ne (i32.load8_u offset=65536 (i32.add (global.get $pos) (i32.const 1))) (i32.const 117)))
                      (then (local.set $bad (i32.const 1)))
                      (else
                        (global.set $pos (i32.add (global.get $pos) (i32.const 2)))
                        (local.set $lo (call $hex4 (local.get $esc)))
                        (if (i32.lt_s (local.get $lo) (i32.const 0))
                          (then (return (i32.const 0))))
                        (if (i32.or (i32.lt_s (local.get $lo) (i32.const 0xDC00))
                                    (i32.gt_s (local.get $lo) (i32.const 0xDFFF)))
                          (then (local.set $bad (i32.const 1)))
                          (else
                            (local.set $cp
                              (i32.add
                                (i32.const 0x10000)
                                (i32.add
                                  (i32.shl (i32.sub (local.get $hi) (i32.const 0xD800)) (i32.const 10))
                                  (i32.sub (local.get $lo) (i32.const 0xDC00))))))))))
                  (else
                    (if (i32.and (i32.ge_s (local.get $hi) (i32.const 0xDC00))
                                 (i32.le_s (local.get $hi) (i32.const 0xDFFF)))
                      (then (local.set $bad (i32.const 1)))
                      (else (local.set $cp (local.get $hi))))))))
            (if (i32.or (i32.eqz (local.get $known)) (local.get $bad))
              (then (return (call $fail (i32.const 6) (local.get $esc)))))
            (local.set $next (call $emit_cp (local.get $keep) (local.get $outlen) (local.get $cp)))
            (if (i32.lt_s (local.get $next) (i32.const 0))
              (then (return (call $fail (i32.const 8) (local.get $start)))))
            (local.set $outlen (local.get $next))))
        (br $again)))
    (i32.const 0))

  (func $parse_number (param $depth i32) (result i32)
    (local $neg i32)
    (local $value f64)
    (local $c i32)
    (local $scale f64)
    (local $eneg i32)
    (local $exp i32)
    (local $p f64)
    (if (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 45))
      (then
        (local.set $neg (i32.const 1))
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (if (i32.ge_s (global.get $pos) (global.get $len))
          (then (return (call $fail (i32.const 2) (global.get $len)))))))
    (if (i32.ge_s (global.get $pos) (global.get $len))
      (then (return (call $fail (i32.const 2) (global.get $len)))))

    (local.set $value (f64.const 0))
    (local.set $c (i32.load8_u offset=65536 (global.get $pos)))
    (if (i32.eq (local.get $c) (i32.const 48))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (if (i32.and (i32.lt_s (global.get $pos) (global.get $len))
                     (i32.and (i32.ge_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48))
                              (i32.le_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 57))))
          (then (return (call $fail (i32.const 5) (global.get $pos))))))
      (else
        (if (i32.and (i32.ge_s (local.get $c) (i32.const 49)) (i32.le_s (local.get $c) (i32.const 57)))
          (then
            (block $done
              (loop $again
                (br_if $done (i32.ge_s (global.get $pos) (global.get $len)))
                (local.set $c (i32.sub (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48)))
                (br_if $done (i32.gt_u (local.get $c) (i32.const 9)))
                (local.set $value
                  (f64.add (f64.mul (local.get $value) (f64.const 10))
                           (f64.convert_i32_u (local.get $c))))
                (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                (br $again))))
          (else (return (call $fail (i32.const 5) (global.get $pos)))))))

    (if (i32.and (i32.lt_s (global.get $pos) (global.get $len))
                 (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 46)))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (if (i32.or (i32.ge_s (global.get $pos) (global.get $len))
                    (i32.or (i32.lt_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48))
                            (i32.gt_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 57))))
          (then (return (call $fail (i32.const 5) (global.get $pos)))))
        (local.set $scale (f64.const 0.1))
        (block $done
          (loop $again
            (br_if $done (i32.ge_s (global.get $pos) (global.get $len)))
            (local.set $c (i32.sub (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48)))
            (br_if $done (i32.gt_u (local.get $c) (i32.const 9)))
            (local.set $value
              (f64.add (local.get $value)
                (f64.mul (f64.convert_i32_u (local.get $c))
                         (local.get $scale))))
            (local.set $scale (f64.mul (local.get $scale) (f64.const 0.1)))
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
            (br $again)))))

    (if (i32.and (i32.lt_s (global.get $pos) (global.get $len))
                 (i32.or (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 101))
                         (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 69))))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (if (i32.and (i32.lt_s (global.get $pos) (global.get $len))
                     (i32.or (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 43))
                             (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 45))))
          (then
            (if (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 45))
              (then (local.set $eneg (i32.const 1))))
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))))
        (if (i32.or (i32.ge_s (global.get $pos) (global.get $len))
                    (i32.or (i32.lt_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48))
                            (i32.gt_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 57))))
          (then (return (call $fail (i32.const 5) (global.get $pos)))))
        (local.set $exp (i32.const 0))
        (block $done
          (loop $again
            (br_if $done (i32.ge_s (global.get $pos) (global.get $len)))
            (br_if $done (i32.lt_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48)))
            (br_if $done (i32.gt_s (i32.load8_u offset=65536 (global.get $pos)) (i32.const 57)))
            (if (i32.lt_s (local.get $exp) (i32.const 10000))
              (then (local.set $exp (i32.add (i32.mul (local.get $exp) (i32.const 10))
                                             (i32.sub (i32.load8_u offset=65536 (global.get $pos)) (i32.const 48))))))
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
            (br $again)))
        (local.set $p (call $pow10i (local.get $exp)))
        (if (local.get $eneg)
          (then (local.set $value (f64.div (local.get $value) (local.get $p))))
          (else (local.set $value (f64.mul (local.get $value) (local.get $p)))))))

    (if (local.get $neg) (then (local.set $value (f64.neg (local.get $value)))))
    (global.set $numbers (i32.add (global.get $numbers) (i32.const 1)))
    (if (i32.eq (local.get $depth) (i32.const 1))
      (then
        (global.set $root_type (i32.const 3))
        (global.set $root_number (local.get $value))))
    (i32.const 1))

  (func $parse_array (param $depth i32) (result i32)
    (local $count i32)
    (local $c i32)
    (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
    (call $skip_ws)
    (if (i32.and (i32.lt_s (global.get $pos) (global.get $len))
                 (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 93)))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (if (i32.eq (local.get $depth) (i32.const 1)) (then (global.set $root_len (i32.const 0))))
        (return (i32.const 1))))
    (local.set $count (i32.const 0))
    (block $done
      (loop $again
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (if (i32.eqz (call $parse_value (i32.add (local.get $depth) (i32.const 1))))
          (then (return (i32.const 0))))
        (call $skip_ws)
        (if (i32.ge_s (global.get $pos) (global.get $len))
          (then (return (call $fail (i32.const 2) (global.get $len)))))
        (local.set $c (i32.load8_u offset=65536 (global.get $pos)))
        (if (i32.eq (local.get $c) (i32.const 44))
          (then
            (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
            (call $skip_ws)
            (if (i32.ge_s (global.get $pos) (global.get $len))
              (then (return (call $fail (i32.const 2) (global.get $len)))))
            (if (i32.eq (i32.load8_u offset=65536 (global.get $pos)) (i32.const 93))
              (then (return (call $fail (i32.const 1) (global.get $pos)))))
            (br $again)))
